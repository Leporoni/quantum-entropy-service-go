# ===== BUILD STAGE =====
FROM golang:1.18-alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 GOOS=linux go build -o /quantum-api ./cmd/quantum-api

# ===== RUN STAGE =====
FROM alpine:3.19

RUN apk add --no-cache ca-certificates

COPY --from=builder /quantum-api /quantum-api

EXPOSE 8081

CMD ["/quantum-api"]
